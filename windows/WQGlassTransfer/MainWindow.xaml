<Window x:Class="WQGlassTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WQGlass Transfer — iPhone ↔ Android ↔ Windows"
        Width="1020" Height="720" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvas}"
        Foreground="{StaticResource TextPrimary}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Mode Switcher Bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="📱 ↔ 💻  WQGlass Transfer" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="iPhone · Android · Windows" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="12,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border x:Name="HostLivePill" Background="#14532D" BorderBrush="#22C55E" BorderThickness="1"
                            CornerRadius="9" Padding="10,4" Margin="0,0,12,0" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="HostLivePillText" Text="● PC Sharing Live" FontSize="11.5" FontWeight="SemiBold" Foreground="#86EFAC"/>
                    </Border>
                    <Button x:Name="ClientTabBtn" Content="📡 Connect to Device" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="ClientTabBtn_Click"/>
                    <Button x:Name="HostTabBtn" Content="🖥️ Share This PC" Style="{StaticResource GlassBtn}" Click="HostTabBtn_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CLIENT MODE PANEL -->
        <Grid x:Name="ClientPanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Connection Card -->
            <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Border x:Name="StatusPill" DockPanel.Dock="Left" Background="#1E293B" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusBadgeText" Text="Scanning Wi-Fi for iPhone, Android &amp; PC…" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                        </Border>
                        <TextBlock x:Name="StorageLabel" DockPanel.Dock="Right" Text="" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Auto-Discovered Devices (same Wi-Fi)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="DiscoveredBox" Height="34" Background="#0F172A" Foreground="#0F172A"
                                      SelectionChanged="DiscoveredBox_SelectionChanged" DisplayMemberPath="DisplayName"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Device Address (IP:Port)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="EndpointBox" Style="{StaticResource GlassTextBox}" Height="34" ToolTip="Example: 192.168.1.42:8765"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="PIN" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PinBox" Style="{StaticResource GlassTextBox}" Height="34" MaxLength="8" KeyDown="PinBox_KeyDown"/>
                        </StackPanel>

                        <Button x:Name="ConnectBtn" Grid.Column="3" Content="Connect" Style="{StaticResource PrimaryBtn}"
                                Height="34" VerticalAlignment="Bottom" Margin="0,0,8,0" Click="ConnectBtn_Click"/>
                        <Button x:Name="ScanBtn" Grid.Column="4" Content="↻ Scan" Style="{StaticResource GlassBtn}"
                                Height="34" VerticalAlignment="Bottom" Click="ScanBtn_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Action Toolbar -->
            <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="SendFilesBtn" Content="⬆ Send Files to Device" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" IsEnabled="False" Click="SendFilesBtn_Click"/>
                        <Button x:Name="SendFolderBtn" Content="📁 Send Folder" Style="{StaticResource GlassBtn}" Margin="0,0,8,0" IsEnabled="False" Click="SendFolderBtn_Click"/>
                        <Button x:Name="DownloadBtn" Content="⬇ Download Selected to PC" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" IsEnabled="False" Click="DownloadBtn_Click"/>
                        <Button x:Name="NewFolderBtn" Content="+ New Folder" Style="{StaticResource GlassBtn}" Margin="0,0,8,0" IsEnabled="False" Click="NewFolderBtn_Click"/>
                        <Button x:Name="RenameBtn" Content="✎ Rename" Style="{StaticResource GlassBtn}" Margin="0,0,8,0" IsEnabled="False" Click="RenameBtn_Click"/>
                        <Button x:Name="DeleteBtn" Content="🗑 Delete" Style="{StaticResource DangerBtn}" Margin="0,0,8,0" IsEnabled="False" Click="DeleteBtn_Click"/>
                        <Button x:Name="OpenPcDirBtn" Content="📂 Open PC Downloads" Style="{StaticResource GlassBtn}" Click="OpenPcDirBtn_Click"/>
                    </WrapPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="UpBtn" Grid.Column="0" Content="↑ Up" Style="{StaticResource GlassBtn}" Margin="0,0,8,0" IsEnabled="False" Click="UpBtn_Click"/>
                        <Button x:Name="RefreshBtn" Grid.Column="1" Content="↻ Refresh" Style="{StaticResource GlassBtn}" Margin="0,0,10,0" IsEnabled="False" Click="RefreshBtn_Click"/>
                        <Border Grid.Column="2" Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                            <TextBlock x:Name="PathLabel" Text="Not connected — Open WQGlass Transfer on iPhone, Android, or another PC"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBox x:Name="SearchBox" Grid.Column="3" Style="{StaticResource GlassTextBox}" Height="32"
                                 ToolTip="Filter current folder…" TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- File Explorer + Drag & Drop Area -->
            <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="16" Padding="10">
                <Grid>
                    <ListView x:Name="FilesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                              SelectionMode="Extended" MouseDoubleClick="FilesList_MouseDoubleClick"
                              SelectionChanged="FilesList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="42" DisplayMemberBinding="{Binding Icon}"/>
                                <GridViewColumn Header="Name" Width="490" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Size" Width="125" DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="Modified" Width="165" DisplayMemberBinding="{Binding ModifiedText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border x:Name="DropOverlay" Background="#CC0F172A" BorderBrush="{StaticResource AccentCyan}" BorderThickness="2"
                            CornerRadius="14" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="Drop files or folders here to send to the connected device" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom Live Transfer Progress Bar -->
            <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="TransferStatusText" DockPanel.Dock="Left"
                                       Text="Tip: Drag &amp; drop any files or folders anywhere on this window to send them to your iPhone, Android, or PC."
                                       FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TransferSpeedText" DockPanel.Dock="Right" Text="" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                        </DockPanel>
                        <ProgressBar x:Name="TransferBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                     Background="#1E293B" Foreground="{StaticResource AccentCyan}" BorderThickness="0"/>
                    </StackPanel>
                    <Button x:Name="CancelTransferBtn" Grid.Column="1" Content="Cancel" Style="{StaticResource DangerBtn}"
                            Visibility="Collapsed" Click="CancelTransferBtn_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- HOST MODE PANEL ("Share This PC") -->
        <Grid x:Name="HostPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Hero Status + PIN + QR Code Card -->
            <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="HostStatusText" Text="PC Host Server Stopped" FontSize="16" FontWeight="Bold" Foreground="#FBBF24"/>
                        <TextBlock Text="Start Host Mode so your iPhone, Android phone, or any browser on the same Wi-Fi can browse, pull, and upload files directly from this PC."
                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,12"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="PAIRING PIN:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="HostPinBigText" Text="----" FontSize="30" FontWeight="ExtraBold" Foreground="{StaticResource AccentCyan}" FontFamily="Consolas"/>
                        </StackPanel>

                        <TextBlock x:Name="HostUrlText" Text="Click Start Sharing PC below to get your Wi-Fi URL &amp; QR code"
                                   FontSize="13" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="HostToggleBtn" Content="▶ Start Sharing PC" Style="{StaticResource PrimaryBtn}" Margin="0,0,10,0" Click="HostToggleBtn_Click"/>
                            <Button x:Name="HostCopyBtn" Content="📋 Copy Address &amp; PIN" Style="{StaticResource GlassBtn}" Margin="0,0,10,0" IsEnabled="False" Click="HostCopyBtn_Click"/>
                            <Button x:Name="HostOpenFolderBtn" Content="📂 Open Shared Folder" Style="{StaticResource GlassBtn}" Click="HostOpenFolderBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Width="164" Height="164">
                        <Image x:Name="HostQrImage" Stretch="Uniform" />
                    </Border>
                </Grid>
            </Border>

            <!-- Host Controls Card -->
            <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Shared Folder on This PC" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="HostFolderBox" Style="{StaticResource GlassTextBox}" Height="34" IsReadOnly="True"/>
                    </StackPanel>

                    <Button x:Name="HostChooseFolderBtn" Grid.Column="1" Content="📁 Choose Folder…" Style="{StaticResource GlassBtn}"
                            Height="34" VerticalAlignment="Bottom" Click="HostChooseFolderBtn_Click"/>

                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Fixed PIN (4–8 digits, optional)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="HostFixedPinBox" Style="{StaticResource GlassTextBox}" Height="34" MaxLength="8"/>
                    </StackPanel>

                    <Button x:Name="HostApplyPinBtn" Grid.Column="4" Content="Apply PIN" Style="{StaticResource PrimaryBtn}"
                            Height="34" VerticalAlignment="Bottom" Margin="0,0,8,0" Click="HostApplyPinBtn_Click"/>
                    <Button x:Name="HostRandomPinBtn" Grid.Column="5" Content="🎲 Random" Style="{StaticResource GlassBtn}"
                            Height="34" VerticalAlignment="Bottom" Click="HostRandomPinBtn_Click"/>
                </Grid>
            </Border>

            <!-- Live Host Activity Log -->
            <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="16" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Live Transfer Activity (Incoming iPhone / Android / Browser Connections)"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <Button DockPanel.Dock="Right" Content="Clear Log" Style="{StaticResource GlassBtn}" Padding="10,4" FontSize="11.5" Click="HostClearLogBtn_Click"/>
                    </DockPanel>
                    <ListBox x:Name="HostLogList" Grid.Row="1" Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}"
                             BorderThickness="1" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="12.5" Padding="6"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
