<Window x:Class="WQGlassTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WQGlass Transfer — iPhone ↔ Windows"
        Width="980" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvas}"
        Foreground="{StaticResource TextPrimary}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Connection Card -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="📱 ↔ 💻  WQGlass Transfer" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <Border x:Name="StatusPill" Background="#1E293B" CornerRadius="10" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusBadgeText" Text="Scanning Wi-Fi for iPhone…" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="StorageLabel" DockPanel.Dock="Right" Text="" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Auto-Discovered iPhones (same Wi-Fi)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DiscoveredBox" Height="34" Background="#0F172A" Foreground="#0F172A"
                                  SelectionChanged="DiscoveredBox_SelectionChanged" DisplayMemberPath="DisplayName"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="iPhone Address (IP:Port)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EndpointBox" Style="{StaticResource GlassTextBox}" Height="34" ToolTip="Example: 192.168.1.42:8765"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="4-Digit PIN" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="PinBox" Style="{StaticResource GlassTextBox}" Height="34" MaxLength="8" KeyDown="PinBox_KeyDown"/>
                    </StackPanel>

                    <Button x:Name="ConnectBtn" Grid.Column="3" Content="Connect" Style="{StaticResource PrimaryBtn}"
                            Height="34" VerticalAlignment="Bottom" Margin="0,0,8,0" Click="ConnectBtn_Click"/>
                    <Button x:Name="ScanBtn" Grid.Column="4" Content="↻ Scan" Style="{StaticResource GlassBtn}"
                            Height="34" VerticalAlignment="Bottom" Click="ScanBtn_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="SendFilesBtn" Content="⬆ Send Files to iPhone" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" IsEnabled="False" Click="SendFilesBtn_Click"/>
                    <Button x:Name="SendFolderBtn" Content="📁 Send Folder" Style="{StaticResource GlassBtn}" Margin="0,0,8,0" IsEnabled="False" Click="SendFolderBtn_Click"/>
                    <Button x:Name="DownloadBtn" Content="⬇ Download Selected to PC" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" IsEnabled="False" Click="DownloadBtn_Click"/>
                    <Button x:Name="NewFolderBtn" Content="+ New Folder" Style="{StaticResource GlassBtn}" Margin="0,0,8,0" IsEnabled="False" Click="NewFolderBtn_Click"/>
                    <Button x:Name="RenameBtn" Content="✎ Rename" Style="{StaticResource GlassBtn}" Margin="0,0,8,0" IsEnabled="False" Click="RenameBtn_Click"/>
                    <Button x:Name="DeleteBtn" Content="🗑 Delete" Style="{StaticResource DangerBtn}" Margin="0,0,8,0" IsEnabled="False" Click="DeleteBtn_Click"/>
                    <Button x:Name="OpenPcDirBtn" Content="📂 Open PC Folder" Style="{StaticResource GlassBtn}" Click="OpenPcDirBtn_Click"/>
                </WrapPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UpBtn" Grid.Column="0" Content="↑ Up" Style="{StaticResource GlassBtn}" Margin="0,0,8,0" IsEnabled="False" Click="UpBtn_Click"/>
                    <Button x:Name="RefreshBtn" Grid.Column="1" Content="↻ Refresh" Style="{StaticResource GlassBtn}" Margin="0,0,10,0" IsEnabled="False" Click="RefreshBtn_Click"/>
                    <Border Grid.Column="2" Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock x:Name="PathLabel" Text="Not connected — Open WQ Glass → Utility Hub → iPhone ↔ Windows Transfer"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <TextBox x:Name="SearchBox" Grid.Column="3" Style="{StaticResource GlassTextBox}" Height="32"
                             ToolTip="Filter current folder…" TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Grid>
        </Border>

        <!-- File Explorer + Drag & Drop Area -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="16" Padding="10">
            <Grid>
                <ListView x:Name="FilesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                          SelectionMode="Extended" MouseDoubleClick="FilesList_MouseDoubleClick"
                          SelectionChanged="FilesList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="42" DisplayMemberBinding="{Binding Icon}"/>
                            <GridViewColumn Header="Name" Width="470" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Size" Width="125" DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="Modified" Width="160" DisplayMemberBinding="{Binding ModifiedText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border x:Name="DropOverlay" Background="#CC0F172A" BorderBrush="{StaticResource AccentCyan}" BorderThickness="2"
                        CornerRadius="14" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="Drop files or folders here to send to your iPhone" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Live Transfer Progress Bar -->
        <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="TransferStatusText" DockPanel.Dock="Left"
                                   Text="Tip: Drag &amp; drop any files or folders anywhere on this window to send them to your iPhone."
                                   FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="TransferSpeedText" DockPanel.Dock="Right" Text="" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                    </DockPanel>
                    <ProgressBar x:Name="TransferBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Background="#1E293B" Foreground="{StaticResource AccentCyan}" BorderThickness="0"/>
                </StackPanel>
                <Button x:Name="CancelTransferBtn" Grid.Column="1" Content="Cancel" Style="{StaticResource DangerBtn}"
                        Visibility="Collapsed" Click="CancelTransferBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
