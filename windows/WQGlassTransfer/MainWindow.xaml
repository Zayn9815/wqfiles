<Window x:Class="WQGlassTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WQGlass Transfer Studio — Wi-Fi &amp; USB Cable (iPhone · Android · Windows)"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Width="1220" Height="790" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvas}"
        Foreground="{StaticResource TextPrimary}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0" Padding="14,16">
            <DockPanel LastChildFill="False">
                <!-- Brand Logo Header -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,18">
                    <Image Source="pack://application:,,,/Assets/AppLogo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WQGlass Studio" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="v3.1 · USB + Wi-Fi Easy Mode" FontSize="11" Foreground="{StaticResource AccentCyan}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nav Menu -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="EASY NAVIGATION" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="10,0,0,8"/>

                    <Button x:Name="NavWifiBtn" Style="{StaticResource SidebarNavActiveBtn}" Click="NavWifiBtn_Click" ToolTip="Connect to iPhone (USB App Containers or Wi-Fi) and Android">
                        <DockPanel Width="180">
                            <TextBlock DockPanel.Dock="Left" Text="📱  Devices &amp; Explorer" VerticalAlignment="Center"/>
                            <Border x:Name="WifiCountBadge" DockPanel.Dock="Right" Background="#1D4ED8" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="WifiCountText" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </DockPanel>
                    </Button>

                    <Button x:Name="NavUsbBtn" Style="{StaticResource SidebarNavBtn}" Click="NavUsbBtn_Click" ToolTip="Direct USB Cable Storage &amp; iPhone Camera Roll (DCIM) / Android MTP">
                        <DockPanel Width="180">
                            <TextBlock DockPanel.Dock="Left" Text="🔌  USB Cable &amp; DCIM" VerticalAlignment="Center"/>
                            <Border x:Name="UsbCountBadge" DockPanel.Dock="Right" Background="#0F766E" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="UsbCountText" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </DockPanel>
                    </Button>

                    <Button x:Name="NavHostBtn" Style="{StaticResource SidebarNavBtn}" Click="NavHostBtn_Click" ToolTip="Show QR code so iPhone or Android can pull/push files from this PC">
                        <DockPanel Width="180">
                            <TextBlock DockPanel.Dock="Left" Text="🖥️  Share This PC" VerticalAlignment="Center"/>
                            <Border x:Name="HostLiveBadge" DockPanel.Dock="Right" Background="#14532D" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="8" Padding="6,1" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock Text="LIVE" FontSize="9.5" FontWeight="Bold" Foreground="#86EFAC"/>
                            </Border>
                        </DockPanel>
                    </Button>

                    <TextBlock Text="ACTIVITY &amp; TOOLS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="10,16,0,8"/>

                    <Button x:Name="NavHistoryBtn" Style="{StaticResource SidebarNavBtn}" Click="NavHistoryBtn_Click" ToolTip="View completed downloads, uploads, and transfer speeds">
                        <DockPanel Width="180">
                            <TextBlock DockPanel.Dock="Left" Text="📊  Transfer Activity" VerticalAlignment="Center"/>
                            <Border x:Name="HistoryCountBadge" DockPanel.Dock="Right" Background="#1E293B" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="HistoryCountText" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                            </Border>
                        </DockPanel>
                    </Button>

                    <Button x:Name="NavLogsBtn" Style="{StaticResource SidebarNavBtn}" Click="NavLogsBtn_Click" ToolTip="View and copy diagnostic, error, and crash reports">
                        <DockPanel Width="180">
                            <TextBlock DockPanel.Dock="Left" Text="🐞  Logs &amp; Help" VerticalAlignment="Center"/>
                            <Border x:Name="ErrorCountBadge" DockPanel.Dock="Right" Background="#7F1D1D" CornerRadius="8" Padding="6,1" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="ErrorCountText" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#FCA5A5"/>
                            </Border>
                        </DockPanel>
                    </Button>

                    <Button x:Name="NavSettingsBtn" Style="{StaticResource SidebarNavBtn}" Click="NavSettingsBtn_Click" ToolTip="Configure download folder and multi-stream turbo speed">
                        <TextBlock Text="⚙️  Settings &amp; Speed"/>
                    </Button>
                </StackPanel>

                <!-- Bottom Session Summary Card -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="SESSION TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Transferred:" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SessionBytesText" DockPanel.Dock="Right" Text="0 B" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Peak Speed:" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SessionPeakText" DockPanel.Dock="Right" Text="--" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}"/>
                        </DockPanel>
                        <Button Content="📂 Open PC Downloads" Style="{StaticResource GlassBtn}" Padding="8,6" FontSize="11.5" Click="OpenPcDirBtn_Click"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- RIGHT MAIN CONTENT AREA + GLOBAL TOP CONNECTION BAR + PERSISTENT TRANSFER DOCK -->
        <Grid Grid.Column="1" Margin="18,12,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== GLOBAL TOP CONNECTION STATUS BAR (VISIBLE ON ALL TABS) ==================== -->
            <Border x:Name="GlobalTopStatusBar" Grid.Row="0" Background="#101E36" BorderBrush="#2563EB" BorderThickness="1.2" CornerRadius="14" Padding="14,9" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="TopConnDot" Width="11" Height="11" Fill="#FBBF24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TopConnTitleText" Text="○ Not Connected — Plug in iPhone/Android via USB Cable or Connect on Wi-Fi" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="TopConnSubtitleText" Text="Click '🍎 Connect iPhone via USB' for instant App Data Containers &amp; Documents (no Wi-Fi or PIN needed!)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="TopConnModeBadge" Background="#1E293B" BorderBrush="{StaticResource CardBorderBright}" BorderThickness="1" CornerRadius="8" Padding="9,4" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TopConnModeBadgeText" Text="IDLE" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24"/>
                        </Border>
                        <Button x:Name="TopQuickIphoneUsbBtn" Content="🍎 Connect iPhone (USB)" ToolTip="1-Click USB Cable Connection to iPhone App Containers, Documents &amp; Downloads (like 3uTools / iTunes)" Style="{StaticResource EmeraldBtn}" Padding="11,6" FontSize="11.5" Margin="0,0,6,0" Click="UsbIphoneAppBtn_Click"/>
                        <Button x:Name="TopQuickScanQrBtn" Content="📷 Scan QR" ToolTip="Scan QR code from iPhone or Android screen" Style="{StaticResource PrimaryBtn}" Padding="10,6" FontSize="11.5" Margin="0,0,6,0" Click="QrScanBtn_Click"/>
                        <Button x:Name="TopQuickDisconnectBtn" Content="Disconnect" Style="{StaticResource DangerBtn}" Padding="10,6" FontSize="11.5" Visibility="Collapsed" Click="TopQuickDisconnectBtn_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== PANEL 1: DEVICES & FILE EXPLORER (BEGINNER-FRIENDLY) ==================== -->
            <Grid x:Name="WifiPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Step-by-Step Quick Connect Card -->
                <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Border DockPanel.Dock="Left" Background="#13223D" BorderBrush="{StaticResource CardBorderBright}" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusBadgeText" Text="Step 1: Choose USB Cable or Wi-Fi Device below to browse files" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                            </Border>

                            <StackPanel x:Name="StorageMeterPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="StorageLabel" Text="" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ProgressBar x:Name="StorageUsedBar" Style="{StaticResource GlassProgressBar}" Width="110" Height="7" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.9*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Beginner 1-Click USB iPhone Button right inside the main bar -->
                            <Button x:Name="MainIphoneUsbQuickBtn" Grid.Column="0" Content="🍎 iPhone USB (Apps &amp; Docs)"
                                    ToolTip="Connect via USB cable to browse all iPhone App Data Containers, Documents, Downloads &amp; Selected Files (like 3uTools)"
                                    Style="{StaticResource EmeraldBtn}" Height="36" VerticalAlignment="Bottom" Margin="0,0,8,0" Click="UsbIphoneAppBtn_Click"/>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Wi-Fi Devices Found Automatically (iPhone · Android · PC)" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,4"/>
                                <ComboBox x:Name="DiscoveredBox" Style="{StaticResource GlassComboBox}" Height="36"
                                          SelectionChanged="DiscoveredBox_SelectionChanged" DisplayMemberPath="DisplayName"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Address (IP:Port or USB)" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,4"/>
                                <TextBox x:Name="EndpointBox" Style="{StaticResource GlassTextBox}" Height="36" ToolTip="Auto-filled when you pick a device or click iPhone USB"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="PIN (Wi-Fi)" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,4"/>
                                <TextBox x:Name="PinBox" Style="{StaticResource GlassTextBox}" Height="36" MaxLength="8" KeyDown="PinBox_KeyDown" ToolTip="4-digit PIN shown on phone (not required on USB cable)"/>
                            </StackPanel>

                            <Button x:Name="ConnectBtn" Grid.Column="4" Content="Connect" Style="{StaticResource PrimaryBtn}" Height="36" VerticalAlignment="Bottom" Margin="0,0,6,0" Click="ConnectBtn_Click"/>
                            <Button x:Name="ScanBtn" Grid.Column="5" Content="↻" ToolTip="Rescan Wi-Fi &amp; USB" Style="{StaticResource GlassBtn}" Height="36" Width="38" Padding="0" VerticalAlignment="Bottom" Click="ScanBtn_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- File Actions, iPhone Folder Switcher (App Containers / Docs / Downloads / DCIM), Selection Controls & Category Filters -->
                <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Prominent 3uTools-style iPhone Folder Switcher (Works over BOTH USB Cable AND Wi-Fi!) -->
                        <Border x:Name="IphoneRootsBar" Background="#0D1F38" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,9" Visibility="Collapsed">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🍎 iPhone Folders (USB &amp; Wi-Fi):" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="RootBtnAppData" Content="📦 App Data Containers (All Apps)" ToolTip="Browse all installed iPhone app data folders like 3uTools / iTunes File Sharing" Style="{StaticResource FilterChipActiveBtn}" Tag="appdata" Click="IphoneRootSwitch_Click"/>
                                <Button x:Name="RootBtnDownloads" Content="📥 WQ Glass Downloads" ToolTip="Videos, audio &amp; files downloaded in WQ Glass" Style="{StaticResource FilterChipBtn}" Tag="downloads" Click="IphoneRootSwitch_Click"/>
                                <Button x:Name="RootBtnDocuments" Content="📄 WQ Glass Documents" ToolTip="Main WQ Glass Documents directory" Style="{StaticResource FilterChipBtn}" Tag="documents" Click="IphoneRootSwitch_Click"/>
                                <Button x:Name="RootBtnSelected" Content="⭐ My Selected Files (Picked on iPhone)" ToolTip="Files you chose using 'Pick Files from iPhone to Share'" Style="{StaticResource FilterChipBtn}" Tag="selected" Click="IphoneRootSwitch_Click"/>
                                <Button Content="📷 Camera Roll (DCIM via USB)" ToolTip="Switch to iPhone Camera Roll photos &amp; videos over USB" Style="{StaticResource FilterChipBtn}" Click="SwitchToIphoneDcimUsb_Click"/>
                            </WrapPanel>
                        </Border>

                        <!-- Primary Transfer Actions -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="DownloadBtn" Content="⬇ Download Selected to PC" ToolTip="Download checked files or folders to your PC Downloads/WQGlass folder" Style="{StaticResource EmeraldBtn}" Margin="0,0,6,0" IsEnabled="False" Click="DownloadBtn_Click"/>
                            <Button x:Name="SendFilesBtn" Content="⬆ Send Files to Phone" ToolTip="Pick files from your PC to upload into the current folder" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0" IsEnabled="False" Click="SendFilesBtn_Click"/>
                            <Button x:Name="SendFolderBtn" Content="📁 Send Entire Folder" ToolTip="Upload a whole folder from your PC" Style="{StaticResource GlassBtn}" Margin="0,0,6,0" IsEnabled="False" Click="SendFolderBtn_Click"/>
                            <Button x:Name="WifiOpenFolderBtn" Content="📂 Open Folder" ToolTip="Open the selected folder" Style="{StaticResource GlassBtn}" Margin="0,0,6,0" IsEnabled="False" Click="WifiOpenFolderBtn_Click"/>
                            <Button x:Name="NewFolderBtn" Content="+ New Folder" ToolTip="Create a new folder here" Style="{StaticResource GlassBtn}" Margin="0,0,6,0" IsEnabled="False" Click="NewFolderBtn_Click"/>
                            <Button x:Name="RenameBtn" Content="✎ Rename" ToolTip="Rename the selected file or folder" Style="{StaticResource GlassBtn}" Margin="0,0,6,0" IsEnabled="False" Click="RenameBtn_Click"/>
                            <Button x:Name="DeleteBtn" Content="🗑 Delete" ToolTip="Delete selected items" Style="{StaticResource DangerBtn}" Margin="0,0,6,0" IsEnabled="False" Click="DeleteBtn_Click"/>
                            <Button x:Name="SendTextBtn" Content="📋 Send Text/Link" ToolTip="Copy text or a web link directly to the phone's clipboard" Style="{StaticResource GlassBtn}" IsEnabled="False" Click="SendTextBtn_Click"/>
                        </WrapPanel>

                        <!-- Selection & Category Filter Bar -->
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SelectAllBtn" Content="☑ Select All" Style="{StaticResource GlassBtn}" Padding="9,5" FontSize="11.5" Margin="0,0,6,0" IsEnabled="False" Click="SelectAllBtn_Click"/>
                                <Button x:Name="DeselectAllBtn" Content="☐ Deselect" Style="{StaticResource GlassBtn}" Padding="9,5" FontSize="11.5" Margin="0,0,6,0" IsEnabled="False" Click="DeselectAllBtn_Click"/>
                                <Button x:Name="InvertSelBtn" Content="⇄ Invert" Style="{StaticResource GlassBtn}" Padding="9,5" FontSize="11.5" Margin="0,0,10,0" IsEnabled="False" Click="InvertSelBtn_Click"/>
                                <Border Background="#0E1C36" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="WifiSelectionSummary" Text="0 selected" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ChipAll" Content="All" Style="{StaticResource FilterChipActiveBtn}" Tag="All" Click="WifiCategoryChip_Click"/>
                                <Button x:Name="ChipFolders" Content="Folders" Style="{StaticResource FilterChipBtn}" Tag="Folders" Click="WifiCategoryChip_Click"/>
                                <Button x:Name="ChipVideos" Content="Videos" Style="{StaticResource FilterChipBtn}" Tag="Videos" Click="WifiCategoryChip_Click"/>
                                <Button x:Name="ChipPhotos" Content="Photos" Style="{StaticResource FilterChipBtn}" Tag="Photos" Click="WifiCategoryChip_Click"/>
                                <Button x:Name="ChipAudio" Content="Audio" Style="{StaticResource FilterChipBtn}" Tag="Audio" Click="WifiCategoryChip_Click"/>
                                <Button x:Name="ChipDocs" Content="Docs" Style="{StaticResource FilterChipBtn}" Tag="Docs" Click="WifiCategoryChip_Click"/>
                                <Button x:Name="ChipArchives" Content="Archives" Style="{StaticResource FilterChipBtn}" Tag="Archives" Margin="0" Click="WifiCategoryChip_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Path Navigation, Sort & Search -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="136"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="UpBtn" Grid.Column="0" Content="↑ Up" Style="{StaticResource GlassBtn}" Padding="10,6" Margin="0,0,6,0" IsEnabled="False" Click="UpBtn_Click"/>
                            <Button x:Name="RefreshBtn" Grid.Column="1" Content="↻ Refresh" Style="{StaticResource GlassBtn}" Padding="10,6" Margin="0,0,8,0" IsEnabled="False" Click="RefreshBtn_Click"/>
                            <Border Grid.Column="2" Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                <TextBlock x:Name="PathLabel" Text="Not connected — Click '🍎 Connect iPhone (USB)' above, Scan QR, or pick a Wi-Fi device"
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <ComboBox x:Name="SortBox" Grid.Column="3" Style="{StaticResource GlassComboBox}" Height="36" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged">
                                <ComboBoxItem Content="Sort: Name"/>
                                <ComboBoxItem Content="Sort: Size ↓"/>
                                <ComboBoxItem Content="Sort: Newest"/>
                                <ComboBoxItem Content="Sort: Type"/>
                            </ComboBox>
                            <TextBox x:Name="SearchBox" Grid.Column="4" Style="{StaticResource GlassTextBox}" Height="36" ToolTip="Search current folder…" TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- File Explorer Table + Beginner Empty-State Onboarding Overlay -->
                <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="8">
                    <Grid>
                        <ListView x:Name="FilesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                  ItemContainerStyle="{StaticResource GlassListViewItem}"
                                  SelectionMode="Extended" MouseDoubleClick="FilesList_MouseDoubleClick"
                                  SelectionChanged="FilesList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="✓" Width="42">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource GlassCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="WifiItemCheckBox_Click"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="" Width="36" DisplayMemberBinding="{Binding Icon}"/>
                                    <GridViewColumn Header="Name" Width="430" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Type" Width="76" DisplayMemberBinding="{Binding TypeLabel}"/>
                                    <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                                    <GridViewColumn Header="Modified" Width="150" DisplayMemberBinding="{Binding ModifiedText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Beginner 1-2-3 Visual Quick-Start Guide (Shown when not connected yet) -->
                        <Border x:Name="OnboardingGuideOverlay" Background="#F2081121" CornerRadius="12" Padding="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="740">
                                <TextBlock Text="👋  Welcome! Connect Your iPhone or Android in 1 Click" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Choose how you want to connect — both USB Cable and Wi-Fi give you full access to folders &amp; files:" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Card A: USB Cable (Recommended) -->
                                    <Border Grid.Column="0" Background="#10233F" BorderBrush="#14B8A6" BorderThickness="1.5" CornerRadius="14" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="⚡ Option A: USB Cable (Fastest · Like 3uTools)" FontSize="14.5" FontWeight="Bold" Foreground="#5EEAD4" Margin="0,0,0,8"/>
                                            <TextBlock Text="1. Plug your iPhone or Android into this PC with a USB cable." FontSize="12.5" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="2. For iPhone App Data Containers, Documents &amp; Downloads, open WQ Glass on iPhone and click below (no PIN or Wi-Fi needed!):" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                            <Button Content="🍎 Connect iPhone App Containers (USB)" Style="{StaticResource EmeraldBtn}" Height="38" Margin="0,0,0,6" Click="UsbIphoneAppBtn_Click"/>
                                            <Button Content="🔌 Open Android USB / iPhone Camera Roll (DCIM)" Style="{StaticResource GlassBtn}" Height="34" Click="NavUsbBtn_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card B: Wireless Wi-Fi / QR Code -->
                                    <Border Grid.Column="2" Background="#101D35" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="14" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="📶 Option B: Wi-Fi or QR Code (Wireless)" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8"/>
                                            <TextBlock Text="1. Open WQ Glass on your iPhone or Android phone → Transfer tab." FontSize="12.5" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="2. Pick your phone from the dropdown at the top, or scan its QR code:" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                            <Button Content="📷 Scan Phone QR Code" Style="{StaticResource PrimaryBtn}" Height="38" Margin="0,0,0,6" Click="QrScanBtn_Click"/>
                                            <Button Content="🖥️ Show This PC's QR Code Instead" Style="{StaticResource GlassBtn}" Height="34" Click="NavHostBtn_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DropOverlay" Background="#D9070D19" BorderBrush="{StaticResource AccentCyan}" BorderThickness="2"
                                CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⬆  Drop Files or Folders Here" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Multi-stream high-speed transfer will start immediately" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== PANEL 2: USB CABLE TRANSFER ==================== -->
            <Grid x:Name="UsbPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- USB Device Header Card -->
                <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <Border DockPanel.Dock="Left" Background="#0D2A29" BorderBrush="#14B8A6" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="UsbStatusBadge" Text="Plug in an Android phone or iPhone via USB cable for full wire-speed transfer" FontSize="12" FontWeight="SemiBold" Foreground="#5EEAD4"/>
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UsbIphoneAppBtn" Content="🍎 iPhone App Docs (USB)" ToolTip="Connect to iPhone WQ Glass Documents, Downloads &amp; Selected Files via Lightning/USB-C (like iTunes / 3uTools)" Style="{StaticResource PrimaryBtn}" Padding="11,5" FontSize="11.5" Margin="0,0,6,0" Click="UsbIphoneAppBtn_Click"/>
                                <Button Content="⚡ Android ADB Turbo" ToolTip="Forward Android WQGlass Server over USB cable (100+ MB/s)" Style="{StaticResource GlassBtn}" Padding="10,5" FontSize="11.5" Click="UsbAdbBridgeBtn_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Connected USB Cable Devices (Android Storage · iPhone Camera Roll)" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,4"/>
                                <ComboBox x:Name="UsbDevicesBox" Style="{StaticResource GlassComboBox}" Height="36" DisplayMemberPath="DisplayName"/>
                            </StackPanel>

                            <Button x:Name="UsbConnectBtn" Grid.Column="1" Content="🔌 Open USB Device" Style="{StaticResource EmeraldBtn}" Height="36" VerticalAlignment="Bottom" Margin="0,0,8,0" Click="UsbConnectBtn_Click"/>
                            <Button Grid.Column="2" Content="↻ Detect USB" Style="{StaticResource GlassBtn}" Height="36" VerticalAlignment="Bottom" Click="UsbDetectBtn_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- USB Actions & Selection Toolbar -->
                <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="UsbOpenFolderBtn" Content="📂 Open Folder" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0" IsEnabled="False" Click="UsbOpenFolderBtn_Click"/>
                            <Button x:Name="UsbImportFilesBtn" Content="⬆ Import Files to Phone" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0" IsEnabled="False" Click="UsbImportFilesBtn_Click"/>
                            <Button x:Name="UsbImportFolderBtn" Content="📁 Import Folder" Style="{StaticResource GlassBtn}" Margin="0,0,6,0" IsEnabled="False" Click="UsbImportFolderBtn_Click"/>
                            <Button x:Name="UsbExportBtn" Content="⬇ Export Selected to PC" Style="{StaticResource EmeraldBtn}" Margin="0,0,6,0" IsEnabled="False" Click="UsbExportBtn_Click"/>
                            <Button x:Name="UsbNewFolderBtn" Content="+ Folder" Style="{StaticResource GlassBtn}" Margin="0,0,6,0" IsEnabled="False" Click="UsbNewFolderBtn_Click"/>
                            <Button x:Name="UsbDeleteBtn" Content="🗑 Delete" Style="{StaticResource DangerBtn}" IsEnabled="False" Click="UsbDeleteBtn_Click"/>
                        </WrapPanel>

                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UsbSelectAllBtn" Content="☑ Select All" Style="{StaticResource GlassBtn}" Padding="9,5" FontSize="11.5" Margin="0,0,6,0" IsEnabled="False" Click="UsbSelectAllBtn_Click"/>
                                <Button x:Name="UsbDeselectAllBtn" Content="☐ Deselect" Style="{StaticResource GlassBtn}" Padding="9,5" FontSize="11.5" Margin="0,0,6,0" IsEnabled="False" Click="UsbDeselectAllBtn_Click"/>
                                <Button x:Name="UsbInvertSelBtn" Content="⇄ Invert" Style="{StaticResource GlassBtn}" Padding="9,5" FontSize="11.5" Margin="0,0,10,0" IsEnabled="False" Click="UsbInvertSelBtn_Click"/>
                                <Border Background="#0E1C36" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="8,4">
                                    <TextBlock x:Name="UsbSelectionSummary" Text="0 selected" FontSize="11.5" FontWeight="SemiBold" Foreground="#5EEAD4"/>
                                </Border>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UsbChipAll" Content="All" Style="{StaticResource FilterChipActiveBtn}" Tag="All" Click="UsbCategoryChip_Click"/>
                                <Button x:Name="UsbChipFolders" Content="Folders" Style="{StaticResource FilterChipBtn}" Tag="Folders" Click="UsbCategoryChip_Click"/>
                                <Button x:Name="UsbChipVideos" Content="Videos" Style="{StaticResource FilterChipBtn}" Tag="Videos" Click="UsbCategoryChip_Click"/>
                                <Button x:Name="UsbChipPhotos" Content="Photos" Style="{StaticResource FilterChipBtn}" Tag="Photos" Click="UsbCategoryChip_Click"/>
                                <Button x:Name="UsbChipAudio" Content="Audio" Style="{StaticResource FilterChipBtn}" Tag="Audio" Click="UsbCategoryChip_Click"/>
                                <Button x:Name="UsbChipDocs" Content="Docs" Style="{StaticResource FilterChipBtn}" Tag="Docs" Margin="0" Click="UsbCategoryChip_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="210"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="UsbUpBtn" Grid.Column="0" Content="↑ Up" Style="{StaticResource GlassBtn}" Padding="10,6" Margin="0,0,6,0" IsEnabled="False" Click="UsbUpBtn_Click"/>
                            <Button x:Name="UsbRefreshBtn" Grid.Column="1" Content="↻ Refresh" Style="{StaticResource GlassBtn}" Padding="10,6" Margin="0,0,8,0" IsEnabled="False" Click="UsbRefreshBtn_Click"/>
                            <Border Grid.Column="2" Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                <TextBlock x:Name="UsbPathLabel" Text="No USB device opened — Select a device above and click Open USB Device" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <TextBox x:Name="UsbSearchBox" Grid.Column="3" Style="{StaticResource GlassTextBox}" Height="36" ToolTip="Filter USB folder…" TextChanged="UsbSearchBox_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- USB File List -->
                <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="8">
                    <Grid>
                        <ListView x:Name="UsbFilesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                  ItemContainerStyle="{StaticResource GlassListViewItem}"
                                  SelectionMode="Extended" MouseDoubleClick="UsbFilesList_MouseDoubleClick"
                                  SelectionChanged="UsbFilesList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="✓" Width="42">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource GlassCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="UsbItemCheckBox_Click"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="" Width="36" DisplayMemberBinding="{Binding Icon}"/>
                                    <GridViewColumn Header="Name" Width="430" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Type" Width="76" DisplayMemberBinding="{Binding TypeLabel}"/>
                                    <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                                    <GridViewColumn Header="Modified" Width="150" DisplayMemberBinding="{Binding ModifiedText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border x:Name="UsbDropOverlay" Background="#D9070D19" BorderBrush="#14B8A6" BorderThickness="2"
                                CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock Text="🔌  Drop Files or Folders Here to Import via USB Cable" FontSize="20" FontWeight="Bold"
                                       Foreground="#5EEAD4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== PANEL 3: SHARE THIS PC (HOST) ==================== -->
            <Grid x:Name="HostPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Name="HostStatusText" Text="PC Host Server Stopped" FontSize="17" FontWeight="Bold" Foreground="#FBBF24"/>
                            <TextBlock Text="Turn this Windows PC into a high-speed Wi-Fi file server so your iPhone, Android phone, or any browser can scan the QR code and pull or push files directly."
                                       FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,12"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="PAIRING PIN:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="HostPinBigText" Text="----" FontSize="32" FontWeight="ExtraBold" Foreground="{StaticResource AccentCyan}" FontFamily="Consolas"/>
                            </StackPanel>

                            <TextBlock x:Name="HostUrlText" Text="Click Start Sharing PC below to generate your Wi-Fi URL &amp; QR code"
                                       FontSize="13" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>

                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="HostToggleBtn" Content="▶ Start Sharing PC" Style="{StaticResource EmeraldBtn}" Margin="0,0,10,0" Click="HostToggleBtn_Click"/>
                                <Button x:Name="HostCopyBtn" Content="📋 Copy URL &amp; PIN" Style="{StaticResource GlassBtn}" Margin="0,0,10,0" IsEnabled="False" Click="HostCopyBtn_Click"/>
                                <Button Content="📂 Open Shared Folder" Style="{StaticResource GlassBtn}" Click="HostOpenFolderBtn_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="10" Width="172" Height="172" VerticalAlignment="Center">
                            <Image x:Name="HostQrImage" Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Shared Folder on This PC" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,4"/>
                                <TextBox x:Name="HostFolderBox" Style="{StaticResource GlassTextBox}" Height="36" IsReadOnly="True"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📁 Browse…" Style="{StaticResource GlassBtn}" Height="36" VerticalAlignment="Bottom" Click="HostChooseFolderBtn_Click"/>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Fixed PIN (optional)" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,4"/>
                                <TextBox x:Name="HostFixedPinBox" Style="{StaticResource GlassTextBox}" Height="36" MaxLength="8"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="Apply" Style="{StaticResource PrimaryBtn}" Height="36" VerticalAlignment="Bottom" Margin="0,0,6,0" Click="HostApplyPinBtn_Click"/>
                            <Button Grid.Column="5" Content="🎲" ToolTip="Random PIN" Style="{StaticResource GlassBtn}" Height="36" Width="38" Padding="0" VerticalAlignment="Bottom" Click="HostRandomPinBtn_Click"/>
                        </Grid>

                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Quick Share:" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Downloads" Style="{StaticResource FilterChipBtn}" Tag="Downloads" Click="HostQuickFolder_Click"/>
                            <Button Content="Desktop" Style="{StaticResource FilterChipBtn}" Tag="Desktop" Click="HostQuickFolder_Click"/>
                            <Button Content="Documents" Style="{StaticResource FilterChipBtn}" Tag="Documents" Click="HostQuickFolder_Click"/>
                            <Button Content="Videos" Style="{StaticResource FilterChipBtn}" Tag="Videos" Click="HostQuickFolder_Click"/>
                            <Button Content="Pictures" Style="{StaticResource FilterChipBtn}" Tag="Pictures" Click="HostQuickFolder_Click"/>
                            <Button Content="User Profile Root" Style="{StaticResource FilterChipBtn}" Tag="Profile" Click="HostQuickFolder_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Live Incoming Activity (iPhone · Android · Browser)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <Button DockPanel.Dock="Right" Content="Clear Log" Style="{StaticResource GlassBtn}" Padding="10,4" FontSize="11.5" Click="HostClearLogBtn_Click"/>
                        </DockPanel>
                        <ListBox x:Name="HostLogList" Grid.Row="1" Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}"
                                 BorderThickness="1" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="12" Padding="8"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== PANEL 4: TRANSFER HISTORY ==================== -->
            <Grid x:Name="HistoryPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="📊  Transfer Queue &amp; Session History" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="All completed Wi-Fi and USB cable imports/exports from this session." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📂 Open Downloads" Style="{StaticResource GlassBtn}" Margin="0,0,8,0" Click="OpenPcDirBtn_Click"/>
                            <Button Content="Clear History" Style="{StaticResource DangerBtn}" Click="ClearHistoryBtn_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="10">
                    <ListView x:Name="HistoryList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                              ItemContainerStyle="{StaticResource GlassListViewItem}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" Width="80" DisplayMemberBinding="{Binding Timestamp}"/>
                                <GridViewColumn Header="Mode" Width="76" DisplayMemberBinding="{Binding Transport}"/>
                                <GridViewColumn Header="Dir" Width="46" DisplayMemberBinding="{Binding Direction}"/>
                                <GridViewColumn Header="File" Width="360" DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="Size" Width="105" DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="Avg Speed" Width="115" DisplayMemberBinding="{Binding SpeedText}"/>
                                <GridViewColumn Header="Status" Width="110" DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>

            <!-- ==================== PANEL 5: SETTINGS ==================== -->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="⚙️  Transfer Engine &amp; Storage Settings" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>

                            <TextBlock Text="Default PC Download Folder (Wi-Fi Downloads &amp; USB Exports)" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SettingsDownloadDirBox" Style="{StaticResource GlassTextBox}" Height="36" IsReadOnly="True" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="📁 Choose Folder…" Style="{StaticResource GlassBtn}" Height="36" Click="SettingsChooseDownloadDir_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Parallel Wi-Fi Streams (Multi-File Speed Boost)" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ParallelStreamsBox" Style="{StaticResource GlassComboBox}" Height="36" SelectionChanged="SettingsChanged">
                                        <ComboBoxItem Content="1 Stream (Sequential)" Tag="1"/>
                                        <ComboBoxItem Content="2 Streams (Balanced)" Tag="2"/>
                                        <ComboBoxItem Content="3 Streams (Turbo · Recommended)" Tag="3"/>
                                        <ComboBoxItem Content="4 Streams (Maximum LAN)" Tag="4"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="When Destination File Already Exists" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ConflictPolicyBox" Style="{StaticResource GlassComboBox}" Height="36" SelectionChanged="SettingsChanged">
                                        <ComboBoxItem Content="Rename Automatically (file_2.ext)" Tag="Rename"/>
                                        <ComboBoxItem Content="Overwrite Existing File" Tag="Overwrite"/>
                                        <ComboBoxItem Content="Skip Existing File" Tag="Skip"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="18">
                        <StackPanel>
                            <TextBlock Text="⚡  Performance Tips for Maximum Transfer Speed" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8"/>
                            <TextBlock Text="• For 100+ MB/s zero-drop transfers, switch to the 🔌 USB Cable tab and plug your Android phone or iPhone directly into a USB 3.0 port." FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="• Over Wi-Fi, connect both PC and phone to 5 GHz Wi-Fi (not 2.4 GHz) — WQGlass v2.2 uses 4 MB TCP windows, 1 MB streaming chunks, and up to 4 parallel streams." FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="• Shortcuts: Ctrl+A selects all visible items, Esc clears selection, double-click opens folders or downloads files." FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== PANEL 6: DIAGNOSTIC, ERROR & CRASH LOGS ==================== -->
            <Grid x:Name="LogsPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="🐞  Diagnostic, Error &amp; Crash Logs" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="LogsFileLocationText" Text="All Wi-Fi, USB, WPD/MTP, usbmuxd, and crash events are saved automatically so you can share them anytime." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📋 Copy All Logs" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0" Click="CopyLogsBtn_Click"/>
                            <Button Content="💾 Export Log File…" Style="{StaticResource EmeraldBtn}" Margin="0,0,6,0" Click="ExportLogsBtn_Click"/>
                            <Button Content="📂 Open Log Folder" Style="{StaticResource GlassBtn}" Margin="0,0,6,0" Click="OpenLogFolderBtn_Click"/>
                            <Button Content="🧹 Clear Logs" Style="{StaticResource DangerBtn}" Click="ClearLogsBtn_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Show:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="LogChipAll" Content="All Logs" Style="{StaticResource FilterChipActiveBtn}" Tag="ALL" Click="LogFilterChip_Click"/>
                            <Button x:Name="LogChipErrors" Content="Errors &amp; Warnings" Style="{StaticResource FilterChipBtn}" Tag="ERRORS" Click="LogFilterChip_Click"/>
                            <Button x:Name="LogChipCrashes" Content="Crash Reports" Style="{StaticResource FilterChipBtn}" Tag="CRASHES" Click="LogFilterChip_Click"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="↻ Refresh Report" Style="{StaticResource GlassBtn}" Padding="10,4" FontSize="11.5" Click="RefreshLogsBtn_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="10">
                    <TextBox x:Name="DiagnosticLogBox"
                             Background="{StaticResource InputBg}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource CardBorder}"
                             BorderThickness="1"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="12"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"/>
                </Border>
            </Grid>

            <!-- ==================== PERSISTENT BOTTOM LIVE TRANSFER DOCK ==================== -->
            <Border Grid.Row="2" Background="{StaticResource CardElevated}" BorderBrush="{StaticResource CardBorderBright}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="TransferStatusText" DockPanel.Dock="Left"
                                       Text="Ready · Drag &amp; drop files/folders anywhere, check items to batch download, or plug in a USB cable."
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TransferSpeedText" DockPanel.Dock="Right" Text="" FontSize="12"
                                       FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="12,0,0,0"/>
                        </DockPanel>
                        <ProgressBar x:Name="TransferBar" Style="{StaticResource GlassProgressBar}" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                    <Button x:Name="CancelTransferBtn" Grid.Column="1" Content="✕ Cancel" Style="{StaticResource DangerBtn}"
                            Padding="12,6" Visibility="Collapsed" Click="CancelTransferBtn_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
